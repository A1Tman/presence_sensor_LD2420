# Set detected flash size to 4MB to match hardware and avoid warnings
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom partition table with two OTA app slots (see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Build the ESP-MQTT client with MQTT 5 support enabled by default.
# CONFIG_MQTT_PROTOCOL_311 is not set
CONFIG_MQTT_PROTOCOL_5=y

# Only build the SSD1306 driver family for the onboard 72x40 OLED.
# CONFIG_U8G2_DISPLAY_DRIVER_ALL is not set
CONFIG_U8G2_DISPLAY_DRIVER_SSD1306=y

# Enable UART driver (already a default in IDF 5.x)
CONFIG_UART_ISR_IN_IRAM=y

# Console over USB-Serial-JTAG (free GPIO20/21 from UART0)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_NONE is not set

# OTA: roll back to the previous image unless the new one confirms itself
# healthy (MQTT connected + valid radar frames) within OTA_ROLLBACK_TIMEOUT_S.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# OTA: only accept update images signed with our RSA-3072 key. This is app
# signature verification on update only - it does NOT enable Secure Boot and
# burns no eFuses; USB flashing still accepts any image. The key lives outside
# the repo; builds are signed automatically. Back the key up: losing it means
# the next update has to be flashed over USB.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="C:/Users/chris/.esp-keys/ld2420_ota_signing_key.pem"

# MQTT event handling builds HA discovery payloads on the MQTT task; give it
# headroom over the 6 KB default (a 2.5.0 dev build overflowed it).
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_TASK_STACK_SIZE=8192
